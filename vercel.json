{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/danh-muc/tu-hoc",
      "destination": "/danh-muc/tu-ho-so",
      "permanent": true
    },
    {
      "source": "/danh-muc/tu-hoc-tai-lieu",
      "destination": "/danh-muc/tu-ho-so",
      "permanent": true
    },
    {
      "source": "/danh-muc/locker",
      "destination": "/danh-muc/tu-locker",
      "permanent": true
    },
    {
      "source": "/danh-muc/sofa",
      "destination": "/danh-muc/sofa-ghe-cho",
      "permanent": true
    },
    {
      "source": "/danh-muc/truong-hoc",
      "destination": "/danh-muc/noi-that-truong-hoc",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/quote-config.js",
      "destination": "/lead-config.js"
    },
    {
      "source": "/quote-engine.js",
      "destination": "/lead-engine.js"
    },
    {
      "source": "/san-pham/ghe-giam-doc/:code",
      "destination": "/executive-chair-product.html?code=:code"
    },
    {
      "source": "/danh-muc/ghe-giam-doc",
      "destination": "/executive-chair-theone.html"
    },
    {
      "source": "/danh-muc/:slug",
      "destination": "/category.html?cat=:slug"
    },
    {
      "source": "/san-pham/:slug",
      "destination": "/product-detail.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
